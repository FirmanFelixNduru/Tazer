# Node binds 127.0.0.1. Set TAZER_MODE=mock for local demo tokens.
TAZER_MODE=supabase
PORT=8787

# Copy to .env for local use. Use the modern Supabase project keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Leave billing off. Set models approved for the provider's free tier.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
